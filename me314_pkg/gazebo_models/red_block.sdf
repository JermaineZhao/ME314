<sdf version="1.6">
  <model name="block_cylinder">
    <static>false</static>

    <link name="link">

      <!-- ===== Visual ===== -->
      <visual name="visual">
        <geometry>
          <!-- 直径 = 方块边长 = 0.0254 m，高度同样 0.0254 m -->
          <cylinder>
            <radius>0.0127</radius>     <!-- 0.0254 / 2 -->
            <length>0.0254</length>     <!-- 高度 -->
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

      <!-- ===== Collision ===== -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.0127</radius>
            <length>0.0254</length>
          </cylinder>
        </geometry>

        <!-- 摩擦、接触参数保持不变 -->
        <surface>
          <friction>
            <ode>
              <mu>50.0</mu>
              <mu2>50.0</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e9</kp>
              <kd>10</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- ===== Inertial ===== -->
      <!-- 质量沿用 0.001 kg，惯量按实心圆柱近似 Ixx = Iyy = 1/12*m*(3r²+h²),  Izz = 1/2*m*r² -->
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>6.78e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.78e-06</iyy>
          <iyz>0</iyz>
          <izz>8.06e-07</izz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>
